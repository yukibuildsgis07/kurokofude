{
  "permissions": {
    "deny": [
      "Read(./data/raw/**)",
      "Glob(./data/raw/**)",
      "Grep(./data/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python) || exit 2; exec \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_raw.py\""
          }
        ]
      }
    ]
  }
}
